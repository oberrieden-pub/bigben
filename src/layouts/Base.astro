---
import "../styles/fonts.css";
import "../styles/site.css";
import { pub, type Lang } from "../data/pub";
import Lightbox from "../components/Lightbox.astro";
import Icon from "../components/Icon.astro";
import SchemaOrg from "../components/SchemaOrg.astro";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page, e.g. "" for the front page or "de.html". */
  path: string;
  /** Paths of the English and German versions of this page. */
  alt: { en: string; de: string };
  /** Opt a page out of search results. Off by default since go-live. */
  noindex?: boolean;
}

const { lang, title, description, path, alt, noindex = false } = Astro.props;
const site = "https://oberrieden.pub/";
const other = lang === "en" ? alt.de : alt.en;
// The front page's path is "" so the canonical URL is the bare domain, but an
// empty href resolves to the current page, which broke German -> English.
const otherHref = other === "" ? "index.html" : other;
const otherLabel = lang === "en" ? "Deutsch" : "English";
const otherLang = lang === "en" ? "de-CH" : "en";
const home = lang === "en" ? "index.html" : "de.html";
const legal = lang === "en" ? "legal.html" : "impressum.html";
const legalLabel = lang === "en" ? "Impressum & privacy" : "Impressum & Datenschutz";
---

<!doctype html>
<html lang={lang === "en" ? "en" : "de-CH"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/geist-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bitter-700-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="canonical" href={site + path} />

    {/* Pasted into WhatsApp, Instagram or Facebook these pages rendered as a
        bare grey URL. Since everything that changes is routed through those
        apps, the preview card matters more here than on most sites. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={pub.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site + path} />
    <meta property="og:image" content={site + "social-card.jpg"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Big Ben Pub on Alte Landstrasse in Oberrieden" />
    <meta property="og:locale" content={lang === "en" ? "en_GB" : "de_CH"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "de_CH" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#531C23" />
    <link rel="alternate" hreflang="en" href={site + alt.en} />
    <link rel="alternate" hreflang="de-CH" href={site + alt.de} />
    <link rel="alternate" hreflang="x-default" href={site + alt.en} />
    {
      noindex && (
        <>
          {/* The site went live on 20 September 2026 with the owner's approval:
              this default is now off, the Google Business Profile website field
              points here, and the domain goes to Search Console. The prop
              survives so a future draft page can still opt itself out. */}
          <meta name="robots" content="noindex, nofollow" />
        </>
      )
    }
    <SchemaOrg lang={lang} path={path} />
  </head>
  <body>
    <a class="skip" href="#main">
      {lang === "en" ? "Skip to content" : "Zum Inhalt springen"}
    </a>
    <div class="topbar">
      <div class="inner">
        <a class="chip" href={pub.instagram}>
          <Icon name="instagram" />{pub.instagramHandle}
        </a>
        <a class="topmark" href={home}>Big Ben<br />Pub</a>
        <a class="chip right" href={otherHref} hreflang={otherLang} lang={otherLang}>
          {otherLabel}
        </a>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <Lightbox lang={lang} />

    <script is:inline>
      /* Arrows for the photo strips. Native scrolling does the work; this just
         nudges it by roughly one screen for people using a mouse. */
      (function () {
        document.querySelectorAll(".scroller-wrap").forEach(function (wrap) {
          var strip = wrap.querySelector(".scroller");
          if (!strip) return;
          wrap.querySelectorAll("[data-scroll]").forEach(function (btn) {
            btn.addEventListener("click", function () {
              var dir = btn.getAttribute("data-scroll") === "next" ? 1 : -1;
              var calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
              strip.scrollBy({
                left: dir * strip.clientWidth * 0.8,
                behavior: calm ? "auto" : "smooth"
              });
            });
          });
          function sync() {
            var max = strip.scrollWidth - strip.clientWidth - 4;
            var atStart = strip.scrollLeft <= 4;
            var atEnd = strip.scrollLeft >= max;
            wrap.classList.toggle("at-start", atStart);
            wrap.classList.toggle("at-end", atEnd);
            /* Faded is not disabled: a hidden button stayed tabbable and still
               fired, so focus vanished onto something invisible. */
            var prev = wrap.querySelector('[data-scroll="prev"]');
            var next = wrap.querySelector('[data-scroll="next"]');
            if (prev) prev.disabled = atStart;
            if (next) next.disabled = atEnd;
          }
          strip.addEventListener("scroll", sync, { passive: true });
          window.addEventListener("resize", sync);
          /* Lazy images change scrollWidth after first paint, which left the
             forward arrow wrongly disabled on a slow load. */
          strip.querySelectorAll("img").forEach(function (im) {
            if (!im.complete) im.addEventListener("load", sync, { once: true });
          });
          sync();
        });
      })();
    </script>

    <footer>
      <div class="inner">
        <span>
          {pub.name} &middot; {pub.street} &middot; {pub.postcode} {pub.town}
          {" "}{pub.canton}
        </span>
        <a href={legal}>{legalLabel}</a>
        <a class="social" href={pub.facebook}><Icon name="facebook" />Facebook</a>
        <a class="social" href={pub.instagram}><Icon name="instagram" />Instagram</a>
        <a href={otherHref} hreflang={otherLang} lang={otherLang}>{otherLabel}</a>
      </div>
    </footer>
  </body>
</html>
