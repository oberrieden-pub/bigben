---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import { pub } from "../data/pub";
import parkingSign from "../assets/photos/parking-sign.jpg";
import exteriorStreet from "../assets/photos/exterior-street.jpg";

const alt = { en: "getting-here.html", de: "anfahrt.html" };
---

<Base
  lang="en"
  title="Getting to Big Ben Pub"
  description="How to reach the Big Ben Pub at Alte Landstrasse 20, Oberrieden. Two minutes from Oberrieden Dorf station, about 15 minutes by S-Bahn from Zurich and Zug."
  path="getting-here.html"
  alt={alt}
>
  <header class="subhead">
    <div class="inner">
      <a class="back" href="index.html">&larr; Big Ben Pub</a>
      <h1>Getting here</h1>
      <p class="tagline">
        {pub.street} &middot; {pub.postcode} {pub.town} {pub.canton}
      </p>
    </div>
  </header>

  <section class="band">
    <div class="inner">
      <div class="mapwrap">
        <iframe
          title="Map showing the Big Ben Pub at Alte Landstrasse 20, Oberrieden"
          src={pub.mapEmbed("en")}
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
      <p class="caption">
        The map is loaded from Google, which may set Google&rsquo;s cookies.
      </p>

      <p>Or open directions straight away, with the pub already set as the destination.</p>

      <div class="linkrow">
        <a class="btn call" target="_blank" rel="noopener" href={pub.directions("transit")}>
          Directions by train
        </a>
        <a class="btn" target="_blank" rel="noopener" href={pub.directions("driving")}>
          Directions by car
        </a>
        <a class="btn" target="_blank" rel="noopener" href={pub.directions("walking")}>
          Directions on foot
        </a>
      </div>
      <p class="caption">Each opens Google Maps in a new tab and routes from wherever you are.</p>
    </div>
  </section>

  <section class="band dark find">
    <div class="inner">
      <h2>By train</h2>
      <p class="kicker">The easy way</p>
      <div class="cols">
        <div>
          <dl>
            <dt>Station</dt><dd>Oberrieden Dorf, two minutes on foot</dd>
            <dt>From Zurich</dt><dd>About 15 minutes by S-Bahn</dd>
            <dt>From Zug</dt><dd>About 15 minutes by S-Bahn</dd>
          </dl>
          <p class="note">
            Check the last train before you settle in on a match night. We stay
            open later than the timetable does.
          </p>
        </div>
        <div>
          <Photo
            class="shot tall"
            src={exteriorStreet}
            alt="The pub seen from across Alte Landstrasse, with its red frontage."
            widths={[400, 800, 1200]}
            sizes="(max-width: 700px) 92vw, 430px"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="band find">
    <div class="inner">
      <h2>By car</h2>
      <p class="kicker">And where to leave it</p>
      <div class="cols">
        <div>
          <dl>
            <dt>Address</dt>
            <dd>{pub.street}<br />{pub.postcode} {pub.town} {pub.canton}</dd>
            <dt>Parking</dt><dd>A few spaces, guests only. The sign is firm about it.</dd>
            <dt>Phone</dt>
            <dd><a href={pub.phoneHref}>{pub.phoneDisplay}</a></dd>
          </dl>
          <p class="note">Ring us if you cannot find it. It is the red one.</p>
        </div>
        <div>
          <Photo
            class="shot tall"
            src={parkingSign}
            alt="A sign reading Parkplatz Big Ben Pub, nur für Gäste."
            widths={[400, 800, 1200]}
            sizes="(max-width: 700px) 92vw, 430px"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>
</Base>
