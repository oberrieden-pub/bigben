---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Hours from "../components/Hours.astro";
import StatusPill from "../components/StatusPill.astro";
import Gallery from "../components/Gallery.astro";
import { pub } from "../data/pub";

import exteriorFront from "../assets/photos/exterior-front.jpg";
import barTaps from "../assets/photos/bar-taps.jpg";
import barWide from "../assets/photos/bar-wide.jpg";
import dartsBoard from "../assets/photos/darts-board.jpg";
import signHanging from "../assets/photos/sign-hanging.jpg";
import signFascia from "../assets/photos/sign-fascia.jpg";
import exteriorStreet from "../assets/photos/exterior-street.jpg";
import plaque from "../assets/photos/plaque-frisch-vom-fass.jpg";

const alt = { en: "", de: "de.html" };
---

<Base
  lang="en"
  title="Big Ben Pub Oberrieden"
  description="British pub in Oberrieden on Lake Zurich. Live football and rugby, darts, Guinness, Swiss craft beer and single malts. Two minutes from Oberrieden Dorf station."
  path=""
  alt={alt}
>
  <header class="hero">
    <Image
      class="hero-bg"
      src={exteriorFront}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      format="avif"
      quality={68}
      loading="eager"
    />
    <div class="inner">
      <p class="eyebrow">Est. Oberrieden</p>
      <h1 class="wordmark">Big Ben Pub</h1>
      <p class="tagline">Your neighbourhood pub on the lake.</p>
      <StatusPill lang="en" />
      <div class="actions">
        <a class="btn call" href={pub.phoneHref}>{pub.phoneDisplay}</a>
        <a class="btn" href="getting-here.html">Directions</a>
        <a class="btn" href={pub.instagram}>Instagram</a>
      </div>
    </div>
  </header>

  <section class="band dark">
    <div class="inner">
      <h2>Live sport</h2>
      <p class="kicker">Football and rugby</p>
      <div class="panel">
        <p class="big">
          We show all the major football and rugby. If there is a match you want
          to see, ring us and we will tell you whether it is on.
        </p>
        <p>
          This week&rsquo;s matches go up on our Google page and on Instagram,
          usually the day before.
        </p>
        <div class="linkrow">
          <a class="btn call" href={pub.googleProfile}>This week on Google</a>
          <a class="btn" href={pub.instagram}>{pub.instagramHandle}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="inner">
      <h2>Opening hours</h2>
      <p class="kicker">Regular week</p>
      <div class="cols">
        <div><Hours lang="en" /></div>
        <div>
          <p>
            We stay open later for live sport and for events, sometimes a good
            deal later.
          </p>
          <p>
            The hours for any particular day are always right on our Google page.
          </p>
          <p class="note">
            Live Irish music most Sunday afternoons. Whether it is on this
            week goes up on Instagram.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band dark menu">
    <div class="inner">
      <h2>Bar and kitchen</h2>
      <p class="kicker">Snacks only</p>
      <div class="cols">
        <div>
          <h3>On the bar</h3>
          <ul>
            <li>Guinness <small>&mdash; poured properly</small></li>
            <li>Swiss craft beer</li>
            <li>Wine by the glass</li>
            <li>Single malts</li>
          </ul>
        </div>
        <div>
          <h3>Bar snacks</h3>
          <ul>
            <li>Chicken wings</li>
            <li>Fries</li>
            <li>Nachos</li>
            <li>Toasties</li>
            <li>Pies</li>
          </ul>
          <p class="note">Snacks only, no full kitchen.</p>
        </div>
      </div>
      <Image
        class="shot band-photo"
        src={barTaps}
        alt="The bar: taps and the spirits shelf behind."
        widths={[600, 1000, 1600]}
        sizes="(max-width: 940px) 92vw, 900px"
        format="avif"
        quality={70}
        loading="lazy"
      />
    </div>
  </section>

  <section class="band">
    <div class="inner">
      <h2>Darts</h2>
      <p class="kicker">Two boards, open play</p>
      <div class="cols">
        <div>
          <Image
            class="shot tall"
            src={dartsBoard}
            alt="A dartboard mounted in a wooden cabinet."
            widths={[400, 800, 1200]}
            sizes="(max-width: 700px) 92vw, 430px"
            format="avif"
            quality={70}
            loading="lazy"
          />
        </div>
        <div>
          <p>
            Two boards, free to play. Ask behind the bar for arrows if you have
            not brought your own.
          </p>
          <p>
            A proper British pub in a village of five thousand people. People
            meet here halfway between Zurich and Zug, watch the match, and stay
            for a whisky.
          </p>
          <p>
            Live Irish music most Sundays. The whole pub can be hired for
            private parties. Ring Paul on
            <a href={pub.phoneHref}>{pub.phoneDisplay}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band dark">
    <div class="inner">
      <h2>The pub</h2>
      <p class="kicker">Have a look</p>
      <Gallery
        items={[
          { src: barWide, alt: "The bar from the end, taps and optics." },
          { src: signHanging, alt: "A hanging Big Ben Pub sign on a bracket." },
          { src: signFascia, alt: "The Big Ben Pub fascia board above the door." },
          { src: exteriorStreet, alt: "The pub seen from across Alte Landstrasse." },
          { src: plaque, alt: "A Frisch vom Fass beer quality plaque on the door." },
          { src: dartsBoard, alt: "The dartboard in its cabinet." },
        ]}
      />
    </div>
  </section>

  <section class="band find">
    <div class="inner">
      <h2>Finding us</h2>
      <p class="kicker">Oberrieden Dorf</p>
      <div class="cols">
        <div>
          <dl>
            <dt>Address</dt>
            <dd>{pub.street}<br />{pub.postcode} {pub.town} {pub.canton}</dd>
            <dt>Train</dt>
            <dd>Oberrieden Dorf, two minutes on foot</dd>
            <dt>S-Bahn</dt>
            <dd>About 15 minutes from Zurich and from Zug</dd>
            <dt>Parking</dt>
            <dd>A few spaces, for guests only</dd>
            <dt>Phone</dt>
            <dd><a href={pub.phoneHref}>{pub.phoneDisplay}</a></dd>
          </dl>
          <a class="btn call" href="getting-here.html">Map and directions</a>
        </div>
        <div>
          <p class="note">
            No booking system. For a table on a busy match night, or to hire the
            pub, ring us. We answer the phone.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band dark legal">
    <div class="inner">
      <h2>Operator details</h2>
      <p class="kicker">Impressum &amp; privacy</p>
      <div class="cols">
        <div>
          <h3>Impressum</h3>
          <address class="addrblock">
            {pub.legalName}<br />
            trading as {pub.name}<br />
            {pub.street}<br />
            {pub.postcode} {pub.town}, {pub.country.en}
          </address>
          <p>
            Telephone: {pub.phoneDisplay}<br />
            Email: <a href={`mailto:${pub.email}`}>{pub.email}</a><br />
            UID: {pub.uid}
          </p>
          <p class="note">
            Responsible for content: {pub.director}, managing director.
          </p>
        </div>
        <div>
          <h3>Privacy</h3>
          <p>
            This site sets no cookies of its own and uses no analytics. The map
            on the <a href="getting-here.html">Getting here</a> page is loaded
            from Google and may set Google&rsquo;s cookies; no other page embeds
            anything from a third party. The site is hosted on GitHub Pages by
            GitHub, Inc. in the United States, which records ordinary connection
            data including your IP address in order to serve and protect the
            site. Nothing else is collected.
          </p>
          <p>
            If you telephone or write to us, we use what you tell us only to
            answer you. Mail sent to the address above is forwarded by Cloudflare
            to a mailbox held with Google. You have the right to ask what we hold
            and to have it corrected. Write to the address above.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
