---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Photo from "../components/Photo.astro";
import Hours from "../components/Hours.astro";
import StatusPill from "../components/StatusPill.astro";
import Gallery from "../components/Gallery.astro";
import { pub } from "../data/pub";

import exteriorFront from "../assets/photos/exterior-front.jpg";
import barTaps from "../assets/photos/bar-taps.jpg";
import barWide from "../assets/photos/bar-wide.jpg";
import dartsBoard from "../assets/photos/darts-board.jpg";
import signHanging from "../assets/photos/sign-hanging.jpg";
import signFascia from "../assets/photos/sign-fascia.jpg";
import exteriorStreet from "../assets/photos/exterior-street.jpg";
import plaque from "../assets/photos/plaque-frisch-vom-fass.jpg";
import signBrackets from "../assets/photos/sign-brackets.jpg";
import dartsCorner from "../assets/photos/darts-corner.jpg";
import musicBooth from "../assets/photos/music-booth.jpg";
import musicSession from "../assets/photos/music-session.jpg";
import musicTrio from "../assets/photos/music-trio.jpg";
import musicHarp from "../assets/photos/music-harp.jpg";
import musicFiddle from "../assets/photos/music-fiddle.jpg";
import musicRoom from "../assets/photos/music-room.jpg";
import stainedGlass from "../assets/photos/stained-glass.jpg";
import pintAndBoard from "../assets/photos/pint-and-board.jpg";

const alt = { en: "", de: "de.html" };
---

<Base
  lang="de"
  title="Big Ben Pub Oberrieden"
  description="Britischer Pub in Oberrieden am Zürichsee. Fussball, Rugby und Formel 1 auf Wunsch, Darts, meistens sonntags Irish Live-Musik, Guinness und Single Malts. Zwei Minuten vom Bahnhof Oberrieden Dorf."
  path="de.html"
  alt={alt}
>
  <header class="hero">
    <Image
      class="hero-bg"
      src={exteriorFront}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      format="avif"
      quality={68}
      loading="eager"
    />
    <div class="inner">
      <p class="eyebrow">Est. Oberrieden</p>
      <h1 class="wordmark">Big Ben Pub</h1>
      <p class="tagline">Ein britischer Pub, etwas unerwartet am Zürichsee.</p>
      <StatusPill lang="de" />
      <div class="actions">
        <a class="btn call" href={pub.phoneHref}>{pub.phoneDisplay}</a>
        <a class="btn" href="anfahrt.html">Anfahrt</a>
        <a class="btn" href={pub.instagram}><Icon name="instagram" />Instagram</a>
      </div>
    </div>
  </header>

  <section class="band dark">
    <div class="inner">
      <h2>Livesport</h2>
      <p class="kicker">Fussball, Rugby, Formel 1</p>
      <div class="panel">
        <p class="big">
          Fussball, Rugby, Formel 1 und was sonst noch sehenswert ist. Nicht
          alles und nicht automatisch. Sagen Sie uns, was Sie sehen möchten,
          und wir zeigen es, wenn es geht.
        </p>
        <p>
          Rufen Sie vorher an, statt umsonst um den See zu fahren. Was diese
          Woche l&auml;uft, steht auf unserer Google-Seite und auf Instagram,
          meist schon am Vortag.
        </p>
        <div class="linkrow">
          <a class="btn call" href={pub.googleProfile}>Diese Woche auf Google</a>
          <a class="btn" href={pub.instagram}><Icon name="instagram" />{pub.instagramHandle}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="inner">
      <h2>Öffnungszeiten</h2>
      <p class="kicker">Reguläre Woche</p>
      <div class="cols">
        <div><Hours lang="de" /></div>
        <div>
          <p>
            Beim Fussball bleiben wir länger offen. &laquo;Länger&raquo;
            ist dabei sehr dehnbar.
          </p>
          <p>
            Die Zeiten für einen bestimmten Tag stehen immer auf unserer
            Google-Seite.
          </p>
          <p class="note">
            Meistens sonntagnachmittags Irish Live-Musik. Ob am kommenden
            Sonntag gespielt wird, steht auf Instagram.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band dark menu">
    <div class="inner">
      <h2>Bar und Küche</h2>
      <p class="kicker">Nur kleine Gerichte</p>
      <div class="cols">
        <div>
          <h3>An der Bar</h3>
          <ul>
            <li>Guinness <small>&mdash; richtig gezapft, also mit Wartezeit</small></li>
            <li>Schweizer Craft Beer</li>
            <li>Wein im Glas</li>
            <li>Single Malts</li>
          </ul>
        </div>
        <div>
          <h3>Kleine Karte</h3>
          <ul>
            <li>Chicken Wings</li>
            <li>Pommes</li>
            <li>Nachos</li>
            <li>Toasties</li>
            <li>Pies</li>
          </ul>
          <p class="note">Kleinigkeiten, kein Abendessen. Wer drei Gänge sucht, steht im falschen Haus.</p>
        </div>
      </div>
      <Photo
        class="shot band-photo"
        src={barTaps}
        alt="Die Bar: Zapfhähne und dahinter das Spirituosenregal."
        widths={[600, 1000, 1600]}
        sizes="(max-width: 940px) 92vw, 900px"
        loading="lazy"
      />
    </div>
  </section>

  <section class="band">
    <div class="inner">
      <h2>Darts</h2>
      <p class="kicker">Eine Scheibe, freies Spiel</p>
      <div class="cols">
        <div>
          <Photo
            class="shot tall"
            src={dartsBoard}
            alt="Eine Dartscheibe in einem Holzschrank."
            widths={[400, 800, 1200]}
            sizes="(max-width: 700px) 92vw, 430px"
            loading="lazy"
          />
        </div>
        <div>
          <p>
            Eine Scheibe, das Spiel ist gratis. Pfeile gibt es an der Bar,
            falls Sie unbewaffnet erschienen sind. Punktestreitigkeiten
            entscheidet, wer am lautesten ruft.
          </p>
          <p>
            Ein richtiger britischer Pub in einem Dorf mit fünftausend
            Einwohnern, was entweder sehr mutig oder genau richtig ist. Man
            trifft sich auf halbem Weg zwischen Zürich und Zug, will auf ein
            Bier bleiben und bleibt auf drei.
          </p>
          <p>
            Meistens sonntags Irish Live-Musik. Der ganze Pub kann für private
            Anlässe gemietet werden. Rufen Sie Paul an unter
            <a href={pub.phoneHref}>{pub.phoneDisplay}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>


  <section class="band dark">
    <div class="inner">
      <h2>Live-Musik</h2>
      <p class="kicker">Meistens sonntagnachmittags</p>
      <div class="panel">
        <p class="big">
          Eine Irish Session an den meisten Sonntagnachmittagen. Geige,
          Gitarre, Akkordeon, Harfe und wer sonst noch mit einem Instrument und
          dem nötigen Mut auftaucht.
        </p>
        <p>
          Kein Ticket, kein Eintritt. Ob am kommenden Sonntag gespielt wird,
          steht auf Instagram.
        </p>
        <div class="linkrow">
          <a class="btn call" href={pub.instagram}><Icon name="instagram" />{pub.instagramHandle}</a>
        </div>
      </div>
      <Gallery
        label="Fotos der Live-Musik"
        hint="Weiterscrollen, oder ein Foto antippen, um es gross zu sehen."
        items={[
            { src: musicBooth, alt: "Zwei Musiker mit Gitarre und Akkordeon in einer Nische." },
            { src: musicTrio, alt: "Drei Musikerinnen und Musiker mit Harfe und Geigen." },
            { src: musicFiddle, alt: "Eine Geigerin mitten im Stück." },
            { src: musicHarp, alt: "Eine Harfenspielerin während der Sonntagssession." },
            { src: musicSession, alt: "Die Session in vollem Gang neben dem Fenster." },
            { src: musicRoom, alt: "Ein voller Raum hört der Sonntagssession zu." },
          ]}
      />
    </div>
  </section>

  <section class="band dark">
    <div class="inner">
      <h2>Der Pub</h2>
      <p class="kicker">Ein paar Eindrücke</p>
      <Gallery
        label="Fotos vom Pub"
        hint="Weiterscrollen, oder ein Foto antippen, um es gross zu sehen."
        items={[
          { src: barWide, alt: "Die Bar von der Seite, Zapfhähne und Gläser." },
          { src: signHanging, alt: "Ein Big Ben Pub Schild an einem Ausleger." },
          { src: signFascia, alt: "Das Big Ben Pub Schild über dem Eingang." },
          { src: exteriorStreet, alt: "Der Pub von der Alten Landstrasse aus gesehen." },
          { src: plaque, alt: "Die Plakette Frisch vom Fass an der Tür." },
          { src: dartsBoard, alt: "Die Dartscheibe im Schrank." },
          { src: stainedGlass, alt: "Ein Buntglasfenster im vorderen Raum." },
          { src: pintAndBoard, alt: "Ein Pint an der Bar neben der Tafel." },
          { src: signBrackets, alt: "Die beiden Ausleger-Schilder vom Trottoir aus." },
          { src: dartsCorner, alt: "Die Dartecke mit dem Holzschrank." },
        ]}
      />
    </div>
  </section>

  <section class="band find">
    <div class="inner">
      <h2>So finden Sie uns</h2>
      <p class="kicker">Oberrieden Dorf</p>
      <div class="cols">
        <div>
          <dl>
            <dt>Adresse</dt>
            <dd>{pub.street}<br />{pub.postcode} {pub.town} {pub.canton}</dd>
            <dt>Bahn</dt>
            <dd>Bahnhof Oberrieden Dorf, 2 Minuten zu Fuss</dd>
            <dt>S-Bahn</dt>
            <dd>Rund 15 Minuten von Zürich und von Zug</dd>
            <dt>Parkieren</dt>
            <dd>Einige Plätze, nur für Gäste. Das Schild ist da deutlich.</dd>
            <dt>Telefon</dt>
            <dd><a href={pub.phoneHref}>{pub.phoneDisplay}</a></dd>
            <dt>E-Mail</dt>
            <dd><a href={`mailto:${pub.email}`}>{pub.email}</a></dd>
          </dl>
          <a class="btn call" href="anfahrt.html">Karte und Anfahrt</a>
        </div>
        <div>
          <p class="note">
            Reservationen nehmen wir gerne entgegen, f&uuml;r einen Tisch am
            Spielabend oder f&uuml;r den ganzen Pub. Am schnellsten per Telefon,
            sonst per E-Mail. Keine App, kein QR-Code auf dem Tisch, und es geht
            jemand ran, meistens Paul.
          </p>
        </div>
      </div>
    </div>
  </section>

</Base>
