---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Hours from "../components/Hours.astro";
import StatusPill from "../components/StatusPill.astro";
import Gallery from "../components/Gallery.astro";
import { pub } from "../data/pub";

import exteriorFront from "../assets/photos/exterior-front.jpg";
import barTaps from "../assets/photos/bar-taps.jpg";
import barWide from "../assets/photos/bar-wide.jpg";
import dartsBoard from "../assets/photos/darts-board.jpg";
import signHanging from "../assets/photos/sign-hanging.jpg";
import signFascia from "../assets/photos/sign-fascia.jpg";
import exteriorStreet from "../assets/photos/exterior-street.jpg";
import plaque from "../assets/photos/plaque-frisch-vom-fass.jpg";

const alt = { en: "", de: "de.html" };
---

<Base
  lang="de"
  title="Big Ben Pub Oberrieden"
  description="Britischer Pub in Oberrieden am Zürichsee. Livesport, Darts, Guinness, Schweizer Craft Beer und Single Malts. Zwei Minuten vom Bahnhof Oberrieden Dorf."
  path="de.html"
  alt={alt}
>
  <header class="hero">
    <Image
      class="hero-bg"
      src={exteriorFront}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      format="avif"
      quality={68}
      loading="eager"
    />
    <div class="inner">
      <p class="eyebrow">Est. Oberrieden</p>
      <h1 class="wordmark">Big Ben Pub</h1>
      <p class="tagline">Ihr Quartierpub am Zürichsee.</p>
      <StatusPill lang="de" />
      <div class="actions">
        <a class="btn call" href={pub.phoneHref}>{pub.phoneDisplay}</a>
        <a class="btn" href="anfahrt.html">Anfahrt</a>
        <a class="btn" href={pub.instagram}>Instagram</a>
      </div>
    </div>
  </header>

  <section class="band dark">
    <div class="inner">
      <h2>Livesport</h2>
      <p class="kicker">Fussball und Rugby</p>
      <div class="panel">
        <p class="big">
          Wir zeigen alle grossen Fussball- und Rugbyspiele. Rufen Sie uns an,
          wenn Sie ein bestimmtes Spiel sehen möchten.
        </p>
        <p>
          Die Spiele der Woche stehen auf unserer Google-Seite und auf Instagram,
          meist schon am Vortag.
        </p>
        <div class="linkrow">
          <a class="btn call" href={pub.googleProfile}>Diese Woche auf Google</a>
          <a class="btn" href={pub.instagram}>{pub.instagramHandle}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="inner">
      <h2>Öffnungszeiten</h2>
      <p class="kicker">Reguläre Woche</p>
      <div class="cols">
        <div><Hours lang="de" /></div>
        <div>
          <p>
            Bei Livesport und Anlässen bleiben wir länger offen, manchmal
            deutlich länger.
          </p>
          <p>
            Die Zeiten für einen bestimmten Tag stehen immer auf unserer
            Google-Seite.
          </p>
          <p class="note">
            Meistens sonntagnachmittags Irish Live-Musik. Ob am kommenden
            Sonntag gespielt wird, steht auf Instagram.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band dark menu">
    <div class="inner">
      <h2>Bar und Küche</h2>
      <p class="kicker">Nur kleine Gerichte</p>
      <div class="cols">
        <div>
          <h3>An der Bar</h3>
          <ul>
            <li>Guinness <small>&mdash; richtig gezapft</small></li>
            <li>Schweizer Craft Beer</li>
            <li>Wein im Glas</li>
            <li>Single Malts</li>
          </ul>
        </div>
        <div>
          <h3>Kleine Karte</h3>
          <ul>
            <li>Chicken Wings</li>
            <li>Pommes</li>
            <li>Nachos</li>
            <li>Toasties</li>
            <li>Pies</li>
          </ul>
          <p class="note">Nur kleine Gerichte, keine warme Küche.</p>
        </div>
      </div>
      <Image
        class="shot band-photo"
        src={barTaps}
        alt="Die Bar: Zapfhähne und dahinter das Spirituosenregal."
        widths={[600, 1000, 1600]}
        sizes="(max-width: 940px) 92vw, 900px"
        format="avif"
        quality={70}
        loading="lazy"
      />
    </div>
  </section>

  <section class="band">
    <div class="inner">
      <h2>Darts</h2>
      <p class="kicker">Zwei Scheiben, freies Spiel</p>
      <div class="cols">
        <div>
          <Image
            class="shot tall"
            src={dartsBoard}
            alt="Eine Dartscheibe in einem Holzschrank."
            widths={[400, 800, 1200]}
            sizes="(max-width: 700px) 92vw, 430px"
            format="avif"
            quality={70}
            loading="lazy"
          />
        </div>
        <div>
          <p>
            Zwei Scheiben, das Spiel ist gratis. Pfeile gibt es auf Anfrage an
            der Bar, falls Sie keine eigenen dabeihaben.
          </p>
          <p>
            Ein richtiger britischer Pub in einem Dorf mit fünftausend
            Einwohnern. Man trifft sich hier auf halbem Weg zwischen Zürich und
            Zug, schaut das Spiel und bleibt auf einen Whisky.
          </p>
          <p>
            Meistens sonntags Irish Live-Musik. Der ganze Pub kann für private
            Anlässe gemietet werden. Rufen Sie Paul an unter
            <a href={pub.phoneHref}>{pub.phoneDisplay}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band dark">
    <div class="inner">
      <h2>Der Pub</h2>
      <p class="kicker">Ein paar Eindrücke</p>
      <Gallery
        items={[
          { src: barWide, alt: "Die Bar von der Seite, Zapfhähne und Gläser." },
          { src: signHanging, alt: "Ein Big Ben Pub Schild an einem Ausleger." },
          { src: signFascia, alt: "Das Big Ben Pub Schild über dem Eingang." },
          { src: exteriorStreet, alt: "Der Pub von der Alten Landstrasse aus gesehen." },
          { src: plaque, alt: "Die Plakette Frisch vom Fass an der Tür." },
          { src: dartsBoard, alt: "Die Dartscheibe im Schrank." },
        ]}
      />
    </div>
  </section>

  <section class="band find">
    <div class="inner">
      <h2>So finden Sie uns</h2>
      <p class="kicker">Oberrieden Dorf</p>
      <div class="cols">
        <div>
          <dl>
            <dt>Adresse</dt>
            <dd>{pub.street}<br />{pub.postcode} {pub.town} {pub.canton}</dd>
            <dt>Bahn</dt>
            <dd>Bahnhof Oberrieden Dorf, 2 Minuten zu Fuss</dd>
            <dt>S-Bahn</dt>
            <dd>Rund 15 Minuten von Zürich und von Zug</dd>
            <dt>Parkieren</dt>
            <dd>Einige Plätze, nur für Gäste</dd>
            <dt>Telefon</dt>
            <dd><a href={pub.phoneHref}>{pub.phoneDisplay}</a></dd>
          </dl>
          <a class="btn call" href="anfahrt.html">Karte und Anfahrt</a>
        </div>
        <div>
          <p class="note">
            Keine Online-Reservation. Für einen Tisch an einem Spielabend oder
            für eine private Feier rufen Sie uns bitte an. Wir gehen ans Telefon.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band dark legal">
    <div class="inner">
      <h2>Impressum</h2>
      <p class="kicker">Betreiber &amp; Datenschutz</p>
      <div class="cols">
        <div>
          <h3>Impressum</h3>
          <address class="addrblock">
            {pub.legalName}<br />
            handelnd als {pub.name}<br />
            {pub.street}<br />
            {pub.postcode} {pub.town}, {pub.country.de}
          </address>
          <p>
            Telefon: {pub.phoneDisplay}<br />
            E-Mail: <a href={`mailto:${pub.email}`}>{pub.email}</a><br />
            UID: {pub.uid}
          </p>
          <p class="note">
            Verantwortlich für den Inhalt: {pub.director}, Geschäftsführer.
          </p>
        </div>
        <div>
          <h3>Datenschutz</h3>
          <p>
            Diese Website setzt selbst keine Cookies und verwendet keine
            Analyse-Werkzeuge. Die Karte auf der Seite
            <a href="anfahrt.html">Anfahrt</a> wird von Google geladen; dabei
            können Cookies von Google gesetzt werden. Auf den übrigen Seiten
            werden keine Inhalte von Drittanbietern eingebunden. Die Website wird
            von GitHub, Inc. in den USA auf GitHub Pages gehostet. Dabei werden
            zum Betrieb und zum Schutz der Website übliche Verbindungsdaten
            gespeichert, darunter die IP-Adresse. Weitere Daten werden nicht
            erhoben.
          </p>
          <p>
            Wenn Sie uns anrufen oder schreiben, verwenden wir Ihre Angaben nur,
            um Ihre Anfrage zu beantworten. E-Mails an die oben genannte Adresse
            werden von Cloudflare an ein Postfach bei Google weitergeleitet. Sie
            haben das Recht auf Auskunft und Berichtigung. Wenden Sie sich dazu
            an die oben genannte Adresse.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
