---
import Base from "../layouts/Base.astro";
import { pub } from "../data/pub";

const alt = { en: "legal.html", de: "impressum.html" };
---

<Base
  lang="en"
  title="Operator details and privacy"
  description="Who runs the Big Ben Pub website, and what it does and does not collect."
  path="legal.html"
  alt={alt}
>
  <header class="subhead">
    <div class="inner">
      <a class="back" href="index.html">&larr; Big Ben Pub</a>
      <h1>Operator details</h1>
      <p class="tagline">Impressum and privacy</p>
    </div>
  </header>

  <section class="band legal">
    <div class="inner">
      <div class="cols">
        <div>
          <h3>Impressum</h3>
          <address class="addrblock">
            {pub.legalName}<br />
            trading as {pub.name}<br />
            {pub.street}<br />
            {pub.postcode} {pub.town}, {pub.country.en}
          </address>
          <p>
            Telephone: {pub.phoneDisplay}<br />
            Email: <a href={`mailto:${pub.email}`}>{pub.email}</a><br />
            UID: {pub.uid}
          </p>
          <p class="note">
            Responsible for content: {pub.director}, managing director.
          </p>
        </div>
        <div>
          <h3>Privacy</h3>
          <p>
            This site sets no cookies of its own and uses no analytics of any
            kind. It does load two things from other companies, and both are in
            the United States:
          </p>
          <ul>
            <li>
              <strong>Google Fonts</strong>, on every page, for the typefaces.
              Your IP address is sent to Google LLC in the United States.
            </li>
            <li>
              <strong>Google Maps</strong>, on the
              <a href="getting-here.html">Getting here</a> page only, for the
              map. Google LLC may set its own cookies there.
            </li>
          </ul>
          <p>
            The site is hosted on GitHub Pages by GitHub, Inc. in the United
            States, which records ordinary connection data including your IP
            address in order to serve and protect the site. We collect nothing
            ourselves and keep no records of visits.
          </p>
          <p>
            If you telephone or write to us, we use what you tell us only to
            answer you. Mail sent to the address above is forwarded by
            Cloudflare, Inc. in the United States to a mailbox held with Google
            LLC in the United States. You have the right to ask what we hold, to
            have it corrected or deleted, and to object to its use. Write to the
            address above.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
