---
/* Full screen viewer. Rendered once per page by the layout.
   Uses a native <dialog>, so Escape closes it and focus is trapped without any
   of that being hand-written. */
interface Props { lang: "en" | "de" }
const { lang } = Astro.props;

const copy = {
  en: { close: "Close", prev: "Previous photo", next: "Next photo", of: "of", name: "Photo viewer" },
  de: { close: "Schliessen", prev: "Vorheriges Foto", next: "Nächstes Foto", of: "von", name: "Fotoansicht" },
}[lang];
---

<dialog id="lightbox" class="lightbox" aria-label={copy.name}>
  <button type="button" class="lb-close" data-lb="close" aria-label={copy.close}>&times;</button>
  <button type="button" class="lb-nav lb-prev" data-lb="prev" aria-label={copy.prev}>&lsaquo;</button>
  <button type="button" class="lb-nav lb-next" data-lb="next" aria-label={copy.next}>&rsaquo;</button>
  <figure class="lb-figure">
    <img id="lb-img" alt="" />
    <figcaption id="lb-cap" role="status" aria-live="polite"></figcaption>
  </figure>
</dialog>

<script is:inline define:vars={{ copy }}>
  (function () {
    var dlg = document.getElementById("lightbox");
    var img = document.getElementById("lb-img");
    var cap = document.getElementById("lb-cap");
    if (!dlg || !img || !cap || typeof dlg.showModal !== "function") return;

    var all = Array.prototype.slice.call(document.querySelectorAll(".photo-btn"));
    if (!all.length) return;
    var buttons = all;
    var index = 0;

    /* Prev/next stays within the strip that was opened. Running through every
       photo on the page meant arrowing out of the music strip and into the pub
       one without any indication. */
    function groupFor(btn) {
      /* .scroller is Gallery, .ctrack is Carousel. Miss the second and every
         carousel photograph opens as a group of one - the viewer reads "1 of
         1" and the arrows do nothing, which is how this was found. */
      var strip = btn.closest(".scroller, .ctrack");
      return strip
        ? Array.prototype.slice.call(strip.querySelectorAll(".photo-btn"))
        : [btn];
    }

    /* Astro already generated several widths; take the biggest rather than
       building another file just for this. */
    function largest(el) {
      var best = el.currentSrc || el.src;
      var bestW = 0;
      (el.getAttribute("srcset") || "").split(",").forEach(function (part) {
        var m = part.trim().match(/^(\S+)\s+(\d+)w$/);
        if (m && Number(m[2]) > bestW) { bestW = Number(m[2]); best = m[1]; }
      });
      return best;
    }

    function show(i) {
      index = (i + buttons.length) % buttons.length;
      var source = buttons[index].querySelector("img");
      if (!source) return;
      var described = source.getAttribute("data-alt") || source.alt || "";
      img.src = largest(source);
      img.alt = "";
      cap.textContent =
        (described ? described + "  " : "") +
        (index + 1) + " " + copy.of + " " + buttons.length;
    }

    buttons.forEach(function (btn, i) {
      btn.addEventListener("click", function () {
        buttons = groupFor(btn);
        show(buttons.indexOf(btn));
        lock(true);
        dlg.showModal();
      });
    });

    var fig = dlg.querySelector(".lb-figure");

    /* The page is held still while the dialog is open. Releasing that lock on
       the "close" event alone is not safe: if the event does not arrive the
       page is left permanently unscrollable, which is far worse than the
       problem being solved. So every path releases it directly, and the event
       handlers below are only a backstop for Escape and native dismissal. */
    function lock(on) {
      document.documentElement.classList.toggle("lb-open", on);
    }

    function closeBox() {
      lock(false);
      img.removeAttribute("src");
      img.alt = "";
      if (dlg.open) dlg.close();
    }

    dlg.addEventListener("click", function (e) {
      var action = e.target.getAttribute && e.target.getAttribute("data-lb");
      if (action === "close") { closeBox(); return; }
      if (action === "prev") { show(index - 1); return; }
      if (action === "next") { show(index + 1); return; }
      /* The figure fills the dialog, so a tap on the dark area lands on it
         rather than on the dialog. Without this there is no way out on a phone
         except a corner button. */
      if (e.target === dlg || e.target === fig || e.target === cap) closeBox();
    });

    dlg.addEventListener("keydown", function (e) {
      if (e.key === "ArrowLeft") { e.preventDefault(); show(index - 1); }
      if (e.key === "ArrowRight") { e.preventDefault(); show(index + 1); }
      /* Close Escape ourselves rather than letting the dialog dismiss itself.
         Native dismissal only tells us through the cancel and close events, and
         if those do not arrive the page stays locked. */
      if (e.key === "Escape") { e.preventDefault(); closeBox(); }
    });

    /* Hold the page still while the dialog is open. Without this a vertical
       swipe on the photo scrolls the document underneath, and closing leaves
       you somewhere else entirely. */
    /* Escape fires "cancel" before the dialog closes itself; "close" is the
       belt to that pair of braces. */
    dlg.addEventListener("cancel", function () { closeBox(); });
    dlg.addEventListener("close", function () { closeBox(); });
  })();
</script>
