---
/* A horizontally scrolling strip of photographs.
   Uniform height with natural widths, so portrait and landscape shots sit
   together without either being cropped to death. Scrolling is native, with
   snap points; the arrows are a convenience for mouse users and the strip is
   focusable so it can be scrolled with the keyboard. */
import Photo from "./Photo.astro";

interface Props {
  items: { src: ImageMetadata; alt: string }[];
  label: string;
  lang?: "en" | "de";
  class?: string;
}
const { items, label, lang = "en", class: klass = "" } = Astro.props;
const back = lang === "de" ? `${label}: zurück` : `${label}: back`;
const fwd = lang === "de" ? `${label}: weiter` : `${label}: forward`;
---

{/* role=region belongs on the scrolling container, not on the <ul>. Putting it
    on the list stripped the list semantics, so nobody was told how many photos
    there are or which one they were on.
    Astro braces rather than an HTML comment: this is a note to whoever edits the
    file, and it has no business being shipped to every visitor. */}
<div class:list={["scroller-wrap", klass]} tabindex="0" role="region" aria-label={label}>
  <ul class="scroller">
    {
      items.map((it) => (
        <li>
          <Photo
            src={it.src}
            alt={it.alt}
            widths={[250, 400, 700, 1100]}
            sizes="(max-width: 520px) 260px, 340px"
          />
        </li>
      ))
    }
  </ul>
  <button type="button" class="scroll-btn prev" data-scroll="prev" aria-label={back}>
    &lsaquo;
  </button>
  <button type="button" class="scroll-btn next" data-scroll="next" aria-label={fwd}>
    &rsaquo;
  </button>
</div>
