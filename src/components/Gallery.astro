---
import { Image } from "astro:assets";

interface Props {
  items: { src: ImageMetadata; alt: string }[];
}
const { items } = Astro.props;
---

<ul class="gallery">
  {
    items.map((it) => (
      <li>
        <Image
          src={it.src}
          alt={it.alt}
          widths={[400, 800, 1200]}
          sizes="(max-width: 700px) 92vw, (max-width: 1000px) 44vw, 290px"
          format="avif"
          quality={72}
          loading="lazy"
        />
      </li>
    ))
  }
</ul>
